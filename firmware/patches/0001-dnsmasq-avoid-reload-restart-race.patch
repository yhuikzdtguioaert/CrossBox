+# Snapshot a live instance only after its jail is ready. Keep the process
+# identity and lifecycle fields: a replacement process must not inherit a
+# SIGHUP intended for the instance that was running before the reload.
+dnsmasq_instance_state() {
+	local info running jail_state config_sum
+
+	info="$(ubus call service list '{"name":"dnsmasq","verbose":true}' 2>/dev/null |
+		jsonfilter -e "@.dnsmasq.instances[\"$1\"]")"
+	[ -n "$info" ] || return 1
+	running="$(printf '%s\n' "$info" | jsonfilter -e '@.running')"
+	[ "$running" = true ] || return 1
+	jail_state="$(printf '%s\n' "$info" | jsonfilter -e '@.jail_state')"
+	[ -z "$jail_state" ] || [ "$jail_state" = running ] || return 1
+	config_sum="$(md5sum "$BASECONFIGFILE.$1" 2>/dev/null)" || return 1
+	printf '%s\n%s\n' "$info" "$config_sum" | md5sum | cut -d' ' -f1
+}
+
 reload_service() {
-	rc_procd start_service "$@"
-	procd_send_signal dnsmasq "$@"
+	local instances="$*" cfg state entry before before_states=""
+
+	# UCI section names permit only letters, digits and underscores.
+	for cfg in "$@"; do
+		case "$cfg" in
+			''|*[!a-zA-Z0-9_]*) return 2 ;;
+		esac
+	done
+	[ -n "$instances" ] || {
+		config_load dhcp
+		instances="$(config_foreach echo dnsmasq)"
+	}
+
+	for cfg in $instances; do
+		state="$(dnsmasq_instance_state "$cfg")" || state=""
+		before_states="$before_states $cfg:$state"
+	done
+
+	if [ "$#" -gt 0 ]; then
+		for cfg in "$@"; do
+			rc_procd start_service "$cfg"
+		done
+	else
+		rc_procd start_service
+	fi
+
+	# A restarted instance reads the generated files itself. Signal only the
+	# same ready process whose complete state and config stayed unchanged.
+	# In particular, do not signal a ujail that is still starting.
+	for cfg in $instances; do
+		state="$(dnsmasq_instance_state "$cfg")" || state=""
+		before=""
+		for entry in $before_states; do
+			case "$entry" in
+				"$cfg:"*) before="${entry#*:}"; break ;;
+			esac
+		done
+		[ -n "$before" ] && [ -n "$state" ] && [ "$state" = "$before" ] &&
+			procd_send_signal dnsmasq "$cfg"
+	done
+
+	return 0
 }
 
