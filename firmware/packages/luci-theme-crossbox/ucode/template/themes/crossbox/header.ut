{%
	import { getuid, getspnam, hash } from 'luci.core';
	import { readfile, glob } from 'fs';

	const boardinfo = ubus.call('system', 'board') ?? {};
	const darkpref = 'true';
	// Content-based revision: reproducible firmware builds may preserve mtimes.
	let asset_hash = 0x43524f53;
	let asset_files = [
		'/www' + media + '/cascade.css', '/www' + media + '/mobile.css',
		'/www' + media + '/crossbox.css', '/www' + media + '/logo.svg',
		'/www' + resource + '/crossbox-shell.js', '/www' + resource + '/crossbox-router.js', '/www' + resource + '/crossbox-view.js',
		'/www' + resource + '/crossbox-updates.js', '/www' + resource + '/crossbox.js', '/www' + resource + '/menu-crossbox.js'
	];
	for (let file in glob('/www' + resource + '/view/crossbox/*.js')) push(asset_files, file);
	for (let file in asset_files) asset_hash = hash(readfile(file) ?? '', asset_hash);
	const asset_version = sprintf('cb-%08x', asset_hash);

	http.prepare_content('text/html; charset=UTF-8');
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}" {{ darkpref ? `data-darkmode="${darkpref}"` : '' }}>
	<head>
		<meta charset="utf-8">
		<title>{{ striptags(`${boardinfo.hostname ?? '?'}${dispatched?.title ? ` | ${_(dispatched.title)}` : ''}`) }}</title>
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="darkreader-lock">
		<script>window.crossboxAssetVersion = '{{ asset_version }}';</script>
		<link rel="stylesheet" href="{{ media }}/cascade.css?v={{ asset_version }}">
		<script>document.documentElement.dataset.darkmode='true';try{localStorage.removeItem('crossbox.dark');}catch(e){}</script>
		<link rel="stylesheet" media="only screen and (max-device-width: 854px)" href="{{ media }}/mobile.css?v={{ asset_version }}" />
		<link rel="stylesheet" href="{{ media }}/crossbox.css?v={{ asset_version }}">
		<link rel="icon" href="{{ media }}/logo.svg?v={{ asset_version }}" sizes="any">
		{% if (dispatched?.css): %}
		<link rel="stylesheet" href="{{ resource }}/{{ dispatched.css }}">
		{% endif %}
		{% if (css): %}
		<style title="text/css">{{ css }}</style>
		{% endif %}
		<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
		<script src="{{ resource }}/cbi.js"></script>
	</head>

	<body class="lang_{{ dispatcher.lang }}{{ http.formvalue('crossbox_embed') == '1' ? ' cb-embedded' : '' }}" data-page="{{ entityencode(join('-', length(ctx.request_path) ? ctx.request_path : ctx.path), true) }}">
		<script>try{if(window.frameElement?.dataset.crossboxFrame)document.body.classList.add('cb-embedded');}catch(e){};</script>
		{% if (!blank_page): %}
		<header>
			<a class="brand" href="{{ dispatcher.build_url('admin') }}"><img class="cb-logo" width="43" height="43" src="{{ media }}/logo.svg?v={{ asset_version }}" alt=""><span>Cross<b>Box</b></span></a>
			<ul class="nav" id="topmenu" style="display:none"></ul>
			<div id="indicators" class="pull-right"></div>
		</header>

		<div id="maincontent" class="container">
			<div id="crossbox-topbar"></div>
			<div id="crossbox-system-alerts" hidden>
			{% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
				<div class="alert-message warning">
					<h4>{{ _('No password set!') }}</h4>
					<p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
					{% if (dispatcher.lookup("admin/system/admin")): %}
					  <div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/admin") }}">{{ _('Go to password configuration...') }}</a></div>
					{% endif %}
				</div>
			{% endif %}

			{% if (boardinfo.rootfs_type == "initramfs"): %}
				<div class="alert-message warning">
					<h4>{{ _('System running in recovery (initramfs) mode.') }}</h4>
					<p>{{ _('No changes to settings will be stored and are lost after rebooting. This mode should only be used to install a firmware upgrade') }}</p>
					{% if (dispatcher.lookup("admin/system/flash")): %}
					  <div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/flash") }}">{{ _('Go to firmware upgrade...') }}</a></div>
					{% endif %}
				</div>
			{% endif %}

			</div>
			<noscript>
				<div class="alert-message warning">
					<h4>{{ _('JavaScript required!') }}</h4>
					<p>{{ replace(_('You must enable JavaScript in your browser or LuCI will not work properly.'), 'LuCI', 'CrossBox') }}</p>
				</div>
			</noscript>

			<div id="tabmenu" style="display:none"></div>
		{% endif %}
