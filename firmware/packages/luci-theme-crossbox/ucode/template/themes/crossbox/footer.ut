		{% if (!blank_page): %}
		</div>
		<footer>
			<span>
				CrossBox
				· <a href="{{ dispatcher.build_url('admin/crossbox/system') }}">{{ _('System') }}</a>
				{% if (lua_active): %}
					/ {{ _('Lua compatibility mode active') }}
				{% endif %}
			</span>
			<ul class="breadcrumb pull-right" id="modemenu" style="display:none"></ul>
		</footer>
		<script>L.env.resource_version = window.crossboxAssetVersion || L.env.resource_version; L.require('crossbox-shell');</script>
		{% endif %}
	</body>
</html>
