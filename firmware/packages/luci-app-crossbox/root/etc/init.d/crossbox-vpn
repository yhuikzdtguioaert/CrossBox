#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

start_service() {
    [ "$(jsonfilter -i /etc/crossbox/vpn.json -e '@.enabled' 2>/dev/null)" = true ] || return 0
    [ -x /usr/bin/mihomo ] || { echo 'Mihomo is not installed' > /tmp/crossbox-vpn.error; return 1; }
    /usr/bin/mihomo -t -d /etc/crossbox -f /etc/crossbox/config.json >/dev/null 2>&1 || {
        echo 'Mihomo configuration check failed' > /tmp/crossbox-vpn.error; return 1;
    }
    procd_open_instance
    procd_set_param command /usr/bin/mihomo -d /etc/crossbox -f /etc/crossbox/config.json
    procd_set_param respawn 3600 5 3
    procd_set_param env GOGC=50 GOMEMLIMIT=96MiB
    procd_set_param limits nofile='4096 4096'
    procd_set_param file /etc/crossbox/config.json /etc/crossbox/proxies.txt
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
