CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
CONFIG_TARGET_qualcommax_ipq50xx_DEVICE_tplink_archer-ax55-v1=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_PACKAGE_luci=y
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_PACKAGE_luci-app-crossbox=y
CONFIG_PACKAGE_luci-theme-crossbox=y
CONFIG_PACKAGE_crossbox-mihomo=y
CONFIG_PACKAGE_crossbox-zapret2=y
CONFIG_LUCI_LANG_ru=y
CONFIG_PACKAGE_luci-i18n-crossbox-ru=y
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="CrossBox"
CONFIG_VERSION_NUMBER="0.1.0-dev"
CONFIG_VERSION_FILENAMES=y
# CONFIG_VERSION_CODE_FILENAMES is not set
CONFIG_VERSION_HOME_URL="https://github.com/yhuikzdtguioaert/CrossBox"
CONFIG_VERSION_BUG_URL="https://github.com/yhuikzdtguioaert/CrossBox/issues"
CONFIG_VERSION_SUPPORT_URL="https://github.com/yhuikzdtguioaert/CrossBox/issues"
CONFIG_VERSION_FIRMWARE_URL="https://github.com/yhuikzdtguioaert/CrossBox/releases"
